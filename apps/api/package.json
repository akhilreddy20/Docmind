{
  "name": "@documind/api",
  "version": "1.0.0",
  "scripts": {
    "build": "tsc -p tsconfig.json && cp -r src/db/migrations dist/db/",
    "start": "node dist/main.js",
    "start:worker": "node dist/worker.main.js",
    "dev": "ts-node src/main.ts",
    "dev:worker": "ts-node src/worker.main.ts",
    "migrate": "node dist/db/migrate.cli.js",
    "test": "jest"
  },
  "dependencies": {
    "@nestjs/common": "^10.4.22",
    "@nestjs/core": "^10.4.22",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/platform-express": "^10.4.22",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.5",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "dotenv": "^16.6.1",
    "ioredis": "^5.11.1",
    "mammoth": "^1.13.0",
    "openai": "^4.104.0",
    "pdf-parse": "^2.4.5",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.25",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.3.0",
    "@types/node": "^22.20.5",
    "@types/pg": "^8.23.1",
    "jest": "^29.7.0",
    "ts-jest": "^29.4.15",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3"
  },
  "private": true,
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "roots": [
      "<rootDir>/test"
    ],
    "transform": {
      "^.+\\.ts$": [
        "ts-jest",
        {
          "tsconfig": "tsconfig.test.json"
        }
      ]
    },
    "setupFiles": [
      "<rootDir>/test/setup-env.ts"
    ]
  }
}
